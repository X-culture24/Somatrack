# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO

# --- Daraja environment ---
# "sandbox" while testing, "production" once you go live.
DARAJA_ENV=sandbox

# From https://developer.safaricom.co.ke -> My Apps -> your app
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# The shortcode B2C payments are disbursed FROM (PartyA). For sandbox this
# is the Test Credentials shortcode Safaricom gives you (often 600000-ish).
DARAJA_INITIATOR_SHORTCODE=

# The API operator name configured for that shortcode on the Daraja portal
# (sandbox default is usually "testapi").
DARAJA_INITIATOR_NAME=testapi

# Plaintext initiator password (sandbox default is usually "Safaricom999!bank").
# Used locally to derive SecurityCredential; never sent to Safaricom as-is.
DARAJA_INITIATOR_PASSWORD=

# Path to Safaricom's public certificate used to encrypt the password above.
# Download: sandbox cert from the Daraja docs "B2C" page, production cert
# from your production onboarding pack. Place it under certs/ (see README).
DARAJA_CERTIFICATE_PATH=certs/SandboxCertificate.cer

# One of: SalaryPayment, BusinessPayment, PromotionPayment
DARAJA_B2C_COMMAND_ID=BusinessPayment

# Publicly reachable HTTPS URLs (e.g. an ngrok tunnel in development) that
# Safaricom will POST the payment result / timeout notifications to.
DARAJA_B2C_RESULT_URL=https://your-domain-or-ngrok-url/api/b2c/callback/result/
DARAJA_B2C_TIMEOUT_URL=https://your-domain-or-ngrok-url/api/b2c/callback/timeout/

# Optional shared-secret header (X-API-KEY) required to call /api/b2c/initiate/.
# Leave blank to disable (e.g. while you add your own auth in front of it).
DARAJA_API_SHARED_SECRET=
