# Document signing (QR codes on receipts/results). Generate once with:
#   go run ./cmd/signing-keygen -out secrets/signing_ed25519.pem
# Required: the api refuses to start if this is unset, unreadable, not Ed25519,
# or readable by group/others (keep it chmod 600).
SIGNING_KEY_PATH=secrets/signing_ed25519.pem
SIGNING_KEY_ID=1
# After rotating: list old public keys so already-printed documents still verify
#   SIGNING_RETIRED_KEYS=1:<base64url public key>
SIGNING_RETIRED_KEYS=
